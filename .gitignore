# ---- Python / Streamlit project .gitignore ----

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files (never commit secrets)
.env
.env.*
*.env

# Streamlit secrets (MUST NOT be committed)
.streamlit/secrets.toml
# Exclude the entire .streamlit folder except config.toml
.streamlit/*
!.streamlit/config.toml

# Logs
logs/
logs/*.csv
*.log

# CSV
*.csv

# old codes
old_codes/

# downloaded files
downloaded_cvs/

# Generate password file and ipynb
generate_password.py
get_reference_data.ipynb

# test
tests/__pycache__
test_CVs/

# qr codes
qr_codes*/

# fonts
fonts/

# OS / IDE
.DS_Store
images/.DS_Store
.idea/
.vscode/
#Temporary files
*.tmp
*.bak
